{
  "name": "apex-psi-mcp",
  "version": "1.2.2",
  "mcpName": "io.github.kawal393/apex-psi-mcp",
  "description": "APEX PSI MCP server - append-only evidence receipts for AI decisions and documents: seal a record, verify a hash against the public ledger, check a chain, cite a receipt, read Bitcoin anchoring status. Verification is free and needs no account.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./gate": "./dist/gate.js",
    "./agent": "./dist/agent.js",
    "./receiver": "./dist/receiver.js",
    "./sender": "./dist/sender.js"
  },
  "files": [
    "dist",
    "conformance",
    "README.md"
  ],
  "bin": {
    "apex-psi-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check:roundtrip": "node scripts/roundtrip-check.mjs",
    "check:all": "npm run build && node scripts/roundtrip-check.mjs && node scripts/anchor-tool-check.mjs && node scripts/card-copy-check.mjs && node scripts/registry-card-check.mjs && node scripts/gate-check.mjs && node scripts/agent-gate-check.mjs && node scripts/agent-example-check.mjs && node scripts/server-version-check.mjs",
    "check:registry-card": "node scripts/registry-card-check.mjs",
    "check:card-copy": "node scripts/card-copy-check.mjs",
    "check:version": "node scripts/server-version-check.mjs",
    "check:version:selftest": "node scripts/server-version-check.mjs --self-test",
    "check:card-copy:selftest": "node scripts/card-copy-check.mjs --self-test",
    "check:gate": "node scripts/gate-check.mjs",
    "check:agent": "node scripts/agent-gate-check.mjs",
    "check:example": "node scripts/agent-example-check.mjs",
    "make:example": "node scripts/make-signed-example.mjs",
    "check:parity": "node scripts/agent-parity-check.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "apex-psi",
    "cryptographic-verification",
    "provenance",
    "evidence",
    "audit-trail",
    "record-integrity",
    "tamper-evident",
    "append-only-ledger",
    "post-quantum",
    "ai-governance",
    "compliance",
    "ai-agents"
  ],
  "author": "APEX PSI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawal393/apex-psi-mcp-server.git"
  },
  "homepage": "https://www.ai-governance-standard.com/mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
