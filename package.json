{
  "name": "apex-psi-mcp",
  "version": "1.1.2",
  "mcpName": "io.github.kawal393/apex-psi-mcp",
  "description": "APEX PSI MCP server - append-only evidence receipts for AI decisions and documents: seal a record, verify a hash against the public ledger, check a chain, cite a receipt, read Bitcoin anchoring status. Verification is free and needs no account.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "apex-psi-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check:roundtrip": "node scripts/roundtrip-check.mjs",
    "check:all": "npm run build && node scripts/roundtrip-check.mjs && node scripts/anchor-tool-check.mjs && node scripts/card-copy-check.mjs && node scripts/registry-card-check.mjs",
    "check:registry-card": "node scripts/registry-card-check.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "apex-psi",
    "cryptographic-verification",
    "provenance",
    "evidence",
    "audit-trail",
    "record-integrity",
    "tamper-evident",
    "append-only-ledger",
    "post-quantum",
    "ai-governance",
    "compliance",
    "ai-agents"
  ],
  "author": "APEX PSI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawal393/apex-psi-mcp-server.git"
  },
  "homepage": "https://www.ai-governance-standard.com/mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
